generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model UserProfile {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  name                  String?
  currentOrganizationId String?                @map("current_organization_id")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  // Relations
  currentOrganization   Organization?          @relation("CurrentOrganization", fields: [currentOrganizationId], references: [id], onDelete: SetNull)
  organizations         OrganizationMember[]
  invitedOrganizations  OrganizationInvite[]   @relation("InvitedBy")

  @@map("user_profiles")
}

model Organization {
  id          String                @id @default(uuid())
  name        String
  slug        String                @unique
  description String?
  logo        String?
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  // Relations
  members     OrganizationMember[]
  invites     OrganizationInvite[]
  currentUsers UserProfile[]        @relation("CurrentOrganization")

  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  role           MemberRole
  joinedAt       DateTime     @default(now()) @map("joined_at")
  invitedById    String?      @map("invited_by_id")

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           UserProfile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("organization_members")
}

model OrganizationInvite {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  email          String
  role           MemberRole
  invitedById    String       @map("invited_by_id")
  token          String       @unique
  status         InviteStatus @default(PENDING)
  expiresAt      DateTime     @map("expires_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      UserProfile  @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  // Note: No foreign key on email - allows inviting users who don't have accounts yet

  @@index([email])
  @@map("organization_invites")
}

enum MemberRole {
  OWNER
  TRAINER
  ATHLETE
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}
